---
import Layout from '../layouts/Layout.astro';
import FontName from '../components/FontName.astro';
import { load, type CategorySummary } from '../lib/data';
import { pct } from '../lib/format';
import { glyphs } from '../lib/specimen';

const all = load<CategorySummary[]>('categories.json');
const fonts = all.flatMap((c) => c.top);
const sections = [
  { title: 'By traffic and funding', note: 'Overlapping groups: a site can be in the top 1,000 and a Y Combinator company at once.', items: all.filter((c) => c.kind === 'cohort') },
  { title: 'By industry', note: 'Every site belongs to exactly one of these.', items: all.filter((c) => c.kind === 'category') },
].filter((x) => x.items.length);
---

<Layout title="Categories" fonts={fonts} specimenText={glyphs(...fonts.map((f) => f.name))}>
  <section class="wrap hero">
    <h1>By kind of site</h1>
    <p class="lede">Type choices cluster. The most visited sites, the newest startups and the oldest newspapers each have their own habits.</p>
  </section>
  {
    sections.map((sec) => (
      <section class="wrap group">
        <div class="section-head">
          <h2>{sec.title}</h2>
          <p>{sec.note}</p>
        </div>
        <ul class="cat-list">
          {sec.items.map((c) => (
            <li>
              <div class="meta">
                <h3>
                  <a href={`/category/${c.slug}`}>{c.name}</a>
                </h3>
                <p class="small muted num">{c.n.toLocaleString()} sites</p>
                <p class="blurb">{c.blurb}</p>
              </div>
              <ol class="top">
                {c.top.map((f) => (
                  <li>
                    <FontName font={f} />
                    <span class="num muted small">{pct(f.share)}</span>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>

<style>
  .hero {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: 32px;
    display: grid;
    gap: 16px;
  }
  .group + .group {
    padding-top: clamp(56px, 8vw, 96px);
  }
  .cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cat-list > li {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 24px 64px;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .blurb {
    margin-top: 10px;
    color: var(--ink-2);
  }
  .top {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .top li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.2;
    border-bottom: 1px solid var(--rule-soft);
    padding: 4px 0 8px;
  }
  @media (max-width: 720px) {
    .cat-list > li {
      grid-template-columns: 1fr;
    }
  }
</style>
