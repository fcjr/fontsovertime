---
import { existsSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { kb } from '../lib/format';
import { rawUrl, REPO_URL } from '../lib/site';

const root = join(process.cwd(), '..', 'data', 'snapshots');
const list = (kind: string) => {
  const dir = join(root, kind);
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((f) => f.endsWith('.jsonl.gz'))
    .sort()
    .reverse()
    .map((f) => ({ name: f.replace('.jsonl.gz', ''), href: rawUrl(`data/snapshots/${kind}/${f}`), size: statSync(join(dir, f)).size }));
};
const groups = [
  { kind: 'weekly', title: 'Weekly crawls', note: 'Every tracked homepage, once a week.' },
  { kind: 'daily', title: 'Daily crawls', note: 'A few hundred of the best-known sites, every day.' },
  { kind: 'wayback', title: 'Archive backfill', note: 'Quarterly estimates from the Internet Archive and Arquivo.pt.' },
].map((g) => ({ ...g, files: list(g.kind) }));
---

<Layout title="Data" description="Download every Fonts Over Time crawl as CSV or JSON Lines.">
  <section class="wrap hero">
    <h1>The data</h1>
    <p class="lede">The collected font-usage dataset is available under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> for reuse, including commercially, under the license terms.</p>
    <p>The files live in the project’s <a href={REPO_URL}>GitHub repository</a>. See the <a href="#reuse">scope and attribution guidance</a> below before reusing them.</p>
  </section>

  <section class="wrap">
    <div class="latest">
      <div>
        <h2>This week, as a spreadsheet</h2>
        <p class="muted">One row per site: body font, heading font, platform, how the fonts are served, and when we saw it.</p>
      </div>
      <a class="button" href={rawUrl('data/exports/latest.csv')}>Download CSV</a>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="wrap section">
        <div class="section-head">
          <h2>{g.title}</h2>
          <p>{g.note} Gzipped JSON Lines, one object per site with the full detail: every font on the page and its share of the text, declared faces, font files and bytes.</p>
        </div>
        {g.files.length ? (
          <ul class="files">
            {g.files.map((f) => (
              <li>
                <a href={f.href} class="num">
                  {f.name}
                </a>
                <span class="muted small num">{kb(f.size)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">None yet.</p>
        )}
      </section>
    ))
  }
  <section class="wrap section">
    <div class="prose">
      <h2 id="reuse">Reuse and attribution</h2>
      <p>Copyright © 2026 Frank Chiarulli Jr.</p>
      <p>
        Frank Chiarulli Jr. licenses his rights in the collected observations and their compilation in the
        crawl snapshots, CSV exports and generated font-usage aggregates. Other contributors retain their own rights and existing notices.
        When sharing covered material under the license, credit Frank Chiarulli Jr. (Fonts Over Time), retain the supplied copyright and other
        notices, link to this project and the license, and indicate changes. A methodology page or accompanying README is a reasonable place for credit.
      </p>
      <p>
        Fonts themselves, third-party page content (including titles and descriptions in snapshots), upstream site lists and catalogs, and the
        source code are outside this grant. Their existing rights and licenses are unchanged. The license does not impose attribution or other
        conditions on uses that do not require permission under the licensor’s rights.
      </p>
      <p>
        Read the <a href={`${REPO_URL}/blob/main/LICENSE-DATA.md`}>dataset license notice and attribution example</a> for the exact scope,
        exclusions and full legal text. The data is provided without warranties, including as to accuracy or third-party rights.
      </p>
    </div>
  </section>

</Layout>

<style>
  .hero {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: 32px;
    display: grid;
    gap: 16px;
  }
  .latest {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px 40px;
    padding: 28px 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule-soft);
  }
  .latest p {
    margin-top: 8px;
    max-width: 34rem;
  }
  .button {
    display: inline-block;
    background: var(--signal);
    color: var(--paper);
    text-decoration: none;
    font-weight: 600;
    padding: 12px 22px;
  }
  .button:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .files {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 14rem;
    column-gap: 32px;
  }
  .files li {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule-soft);
    break-inside: avoid;
  }
</style>
