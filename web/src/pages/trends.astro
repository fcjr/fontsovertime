---
import Layout from '../layouts/Layout.astro';
import Momentum, { type MomentumData } from '../components/Momentum.astro';
import { load } from '../lib/data';
import { glyphs } from '../lib/specimen';

const m = load<MomentumData>('momentum.json');
const fonts = [m.crawl, m.archive].flatMap((s) => Object.values(s.windows).flatMap((w) => [...w.fonts, ...w.flows.flatMap((f) => [f.from, f.to])]));
---

<Layout
  title="Rising and falling"
  description="Which typefaces websites are switching to and away from, not just which are most used."
  fonts={fonts}
  specimenText={glyphs(...fonts.map((f) => f.name))}
>
  <section class="wrap hero">
    <h1>Rising and falling</h1>
    <p class="lede">
      Each bar counts sites that changed their body font to or away from a font. A small font gaining a few sites can outrank a popular one that
      isn’t moving.
    </p>
  </section>
  <section class="wrap">
    <Momentum data={m} id="trends" limit={12} />
  </section>
  <section class="wrap section">
    <div class="prose small-prose">
      <p>
        A switch counts only when a site shows the new font twice in a row. We drop switches that reverse within a year. Our crawl and the web
        archive history are kept separate because the archive estimates use a different method on a smaller set of sites, so treat them as rougher.
        <a href="/methodology">How the data is collected</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: 16px;
    display: grid;
    gap: 16px;
  }
  .small-prose {
    font-size: 1rem;
    color: var(--ink-2);
  }
</style>
