---
import Layout from '../layouts/Layout.astro';
import Momentum, { type MomentumData } from '../components/Momentum.astro';
import { load } from '../lib/data';
import { glyphs } from '../lib/specimen';

const m = load<MomentumData>('momentum.json');
const fonts = [m.crawl, m.archive].flatMap((s) => Object.values(s.windows).flatMap((w) => [...w.fonts, ...w.flows.flatMap((f) => [f.from, f.to])]));
---

<Layout
  title="Rising and falling"
  description="Which typefaces websites are switching to and away from, not just which are most used."
  fonts={fonts}
  specimenText={glyphs(...fonts.map((f) => f.name))}
>
  <section class="wrap hero">
    <h1>Rising and falling</h1>
    <p class="lede">
      Popularity shows where the web is. Switches show where it’s going. Each bar counts sites that changed their body font to or away from a typeface,
      so a small face gaining a few sites can outrank a giant that’s standing still.
    </p>
  </section>
  <section class="wrap">
    <Momentum data={m} id="trends" limit={12} />
  </section>
  <section class="wrap section">
    <div class="prose small-prose">
      <p>
        A switch counts only when a site shows the new font twice in a row, and a switch that reverses within a year is treated as noise and dropped.
        Our crawl and the Internet Archive history are never mixed: the archive estimates come from a different method on a smaller set of well-known
        sites, so they’re a rougher guide. <a href="/methodology">How the data is collected</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: 16px;
    display: grid;
    gap: 16px;
  }
  .small-prose {
    font-size: 1rem;
    color: var(--ink-2);
  }
</style>
