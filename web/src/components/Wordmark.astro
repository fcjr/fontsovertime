---
interface Props {
  class?: string;
  stacked?: boolean;
}
const { class: cls, stacked = false } = Astro.props;
const words = [
  ['fonts', 250],
  ['over', 550],
  ['time', 900],
] as const;
---

<span class:list={['wordmark', { stacked }, cls]} role="img" aria-label="Fonts Over Time">
  {words.map(([w, wght]) => <span aria-hidden="true" style={`font-variation-settings:'wght' ${wght},'wdth' 100`}>{w}</span>)}
</span>

<style>
  .wordmark {
    font-family: var(--display);
    line-height: 1;
    white-space: nowrap;
    display: inline-flex;
    gap: 0.24em;
    letter-spacing: -0.01em;
  }
  .stacked {
    flex-direction: column;
    gap: 0;
    line-height: 0.9;
  }
</style>
