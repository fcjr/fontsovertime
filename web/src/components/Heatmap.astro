---
import type { FontRef } from '../lib/data';
import { pct } from '../lib/format';
import FontName from './FontName.astro';

interface Props {
  fonts: FontRef[];
  categories: { slug: string; name: string }[];
  values: { share: number; count: number }[][];
}
const { fonts, categories, values } = Astro.props;
const max = Math.max(...values.flat().map((v) => v.share), 0.0001);
const steps = [0, 0.2, 0.4, 0.6, 0.8, 1];
---

<div class="hm" data-heatmap>
  <div class="hm-scroll">
    <table class="hm-table">
      <caption class="sr-only">Share of each category’s homepages that use each font for body text. Select a column heading to sort.</caption>
      <thead>
        <tr>
          <th scope="col" class="corner">
            <button type="button" data-sort="-1" aria-pressed="true">Overall</button>
          </th>
          {
            categories.map((c, j) => (
              <th scope="col" data-col={j}>
                <button type="button" data-sort={j} aria-pressed="false">
                  {c.name}
                </button>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          fonts.map((f, i) => (
            <tr data-order={i} data-vals={JSON.stringify(values[i].map((v) => v.share))}>
              <th scope="row">
                <FontName font={f} />
              </th>
              {values[i].map((v, j) => (
                <td data-col={j} style={`--v:${(v.share / max).toFixed(3)}`} tabindex="0" aria-label={`${f.name} in ${categories[j].name}: ${pct(v.share)}, ${v.count} sites`}>
                  <span class="cell" />
                  <span class="val num">{v.share ? pct(v.share) : '–'}</span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="hm-scale small muted" aria-hidden="true">
    <span>0%</span>
    <span class="ramp">{steps.map((s) => <span style={`--v:${s}`} />)}</span>
    <span class="num">{pct(max)}</span>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-heatmap]')) {
    const tbody = root.querySelector('tbody')!;
    const rows = [...tbody.querySelectorAll<HTMLTableRowElement>('tr')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-sort]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const col = Number(b.dataset.sort);
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const before = new Map(rows.map((r) => [r, r.getBoundingClientRect().top]));
        const sorted = [...rows].sort((a, z) =>
          col < 0 ? Number(a.dataset.order) - Number(z.dataset.order) : JSON.parse(z.dataset.vals!)[col] - JSON.parse(a.dataset.vals!)[col],
        );
        tbody.append(...sorted);
        root.querySelectorAll('[data-col]').forEach((c) => c.classList.toggle('sorted', Number((c as HTMLElement).dataset.col) === col));
        if (reduce) return;
        for (const r of sorted) {
          const dy = before.get(r)! - r.getBoundingClientRect().top;
          if (!dy) continue;
          r.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' });
        }
      }),
    );
    const clear = () => root.querySelectorAll('.hl').forEach((e) => e.classList.remove('hl'));
    root.querySelectorAll<HTMLTableCellElement>('td').forEach((td) => {
      const on = () => {
        clear();
        const col = td.dataset.col;
        td.parentElement!.classList.add('hl');
        root.querySelectorAll(`[data-col="${col}"]`).forEach((c) => c.classList.add('hl'));
      };
      td.addEventListener('pointerenter', on);
      td.addEventListener('focus', on);
    });
    root.addEventListener('pointerleave', clear);
  }
</script>

<style>
  .hm-scroll {
    overflow-x: auto;
  }
  .hm-table {
    border-collapse: separate;
    border-spacing: 2px;
    width: 100%;
    min-width: 1100px;
  }
  thead th {
    font-weight: 500;
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
    vertical-align: bottom;
    padding: 0 0 6px;
  }
  thead button {
    font: inherit;
    color: var(--ink-2);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 4px 2px;
    cursor: pointer;
  }
  thead button:hover,
  thead th.hl button {
    color: var(--ink);
  }
  thead button[aria-pressed='true'] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }
  .corner {
    text-align: left;
  }
  tbody th,
  .corner {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--paper);
  }
  tbody th {
    text-align: left;
    font-weight: 400;
    font-size: 1.25rem;
    padding-right: 16px;
    white-space: nowrap;
    max-width: 14rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  td {
    position: relative;
    height: 40px;
    min-width: 56px;
    padding: 0;
    cursor: default;
    outline: none;
  }
  .cell {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--signal) calc(var(--v) * 100%), var(--paper-2));
    transition: box-shadow 120ms;
  }
  .val {
    position: relative;
    display: block;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    opacity: 0;
  }
  td[style*='--v:0.'] .val {
    color: var(--ink);
  }
  td:is([style*='--v:0.5'], [style*='--v:0.6'], [style*='--v:0.7'], [style*='--v:0.8'], [style*='--v:0.9'], [style*='--v:1']) .val {
    color: #fff;
  }
  tr.hl td .cell,
  td.hl .cell {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 25%, transparent);
  }
  td:hover .cell,
  td:focus-visible .cell {
    box-shadow: inset 0 0 0 2px var(--ink);
  }
  td:hover .val,
  td:focus-visible .val,
  tr.hl .val {
    opacity: 1;
  }
  tr.hl th {
    font-weight: 400;
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .hm-scale {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }
  .ramp {
    display: inline-flex;
    gap: 2px;
  }
  .ramp span {
    width: 28px;
    height: 10px;
    background: color-mix(in srgb, var(--signal) calc(var(--v) * 100%), var(--paper-2));
  }
</style>
