---
import '../styles/global.css';
import { load, type FontRef, type Overview } from '../lib/data';
import { fontLinks } from '../lib/specimen';
import Wordmark from '../components/Wordmark.astro';
import { optOutUrl, REPO_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  fonts?: (FontRef | null | undefined)[];
  specimenText?: string;
  fullSpecimen?: boolean;
}

const { title, description, fonts = [], specimenText, fullSpecimen = false } = Astro.props;
const overview = load<Overview>('overview.json');
const pageTitle = title ? `${title} | Fonts Over Time` : 'Fonts Over Time: what the web is set in';
const desc =
  description ??
  'A weekly record of the typefaces the web’s homepages are set in, by category, with trends and a feed of who switched.';
const links = fontLinks(fonts, { text: specimenText, full: fullSpecimen });
const path = Astro.url.pathname;
const nav = [
  ['/fonts', 'Fonts'],
  ['/trends', 'Trends'],
  ['/categories', 'Categories'],
  ['/changes', 'Switches'],
  ['/pairings', 'Pairings'],
  ['/compare', 'Compare'],
  ['/methodology', 'Method'],
  ['/data', 'Data'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Font switches" href="/changes.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anybody:ital,wdth,wght@0,50..150,100..900;1,50..150,100..900&family=Hanken+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
    />
    {links.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap bar">
        <a class="mark" href="/" aria-label="Fonts Over Time, home">
          <Wordmark class="mark-name" />
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map(([href, label]) => (
                <li>
                  <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="gh" href={REPO_URL} aria-label="Source on GitHub">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                GitHub
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-grid">
        <p class="foot-note">
          Fonts Over Time loads {overview?.n_sites?.toLocaleString() ?? 'a few thousand'} homepages every week in a real browser and records which
          fonts they use. Every snapshot is <a href="/data">free to download</a>.
        </p>
        <ul class="foot-links">
          <li><a href="/methodology">How it works</a></li>
          <li><a href={optOutUrl()}>Opt out your site</a></li>
          <li><a href="/changes.xml">RSS</a></li>
          <li><a href={REPO_URL}>Code and data on GitHub</a></li>
        </ul>
        <p class="made">
          Made with <span class="heart" aria-label="love">♥</span> for fonts by{' '}
          <a href="https://frankchiarulli.com">Frank</a> at the{' '}
          <a class="rc" href="https://www.recurse.com/scout/click?t=ba46ea16fafed13b3f8ccacb0ce83ad1">
            <svg viewBox="0 0 12 15" width="12" height="15" aria-hidden="true" shape-rendering="crispEdges">
              <g fill="currentColor"><rect width="12" height="10" /><rect x="4" y="9" width="4" height="3" /><rect x="1" y="11" width="10" height="4" /><rect y="12" width="12" height="3" /></g>
              <rect x="1" y="1" width="10" height="8" fill="var(--paper)" />
              <rect x="2" y="2" width="8" height="6" fill="currentColor" />
              <g fill="#3dc06c"><rect x="2" y="3" width="1" height="1" /><rect x="4" y="3" width="1" height="1" /><rect x="6" y="3" width="1" height="1" /><rect x="3" y="5" width="2" height="1" /><rect x="6" y="5" width="2" height="1" /></g>
              <g fill="var(--paper)"><rect x="2" y="13" width="1" height="1" /><rect x="3" y="12" width="1" height="1" /><rect x="4" y="13" width="1" height="1" /><rect x="5" y="12" width="1" height="1" /><rect x="6" y="13" width="1" height="1" /><rect x="7" y="12" width="1" height="1" /><rect x="8" y="13" width="1" height="1" /><rect x="9" y="12" width="1" height="1" /></g>
            </svg>Recurse Center</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  const pop = document.createElement('div');
  pop.className = 'tip-pop';
  pop.setAttribute('role', 'tooltip');
  pop.id = 'tip-pop';
  document.body.append(pop);
  let current: Element | null = null;

  function show(target: Element) {
    const text = target.getAttribute('data-tip');
    if (!text) return;
    current = target;
    pop.textContent = text;
    target.setAttribute('aria-describedby', pop.id);
    const r = target.getBoundingClientRect();
    const w = pop.offsetWidth;
    const h = pop.offsetHeight;
    const left = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), innerWidth - w - 8);
    const top = r.top - h - 8 >= 8 ? r.top - h - 8 : r.bottom + 8;
    pop.style.left = `${left}px`;
    pop.style.top = `${top}px`;
    pop.classList.add('show');
  }
  function hide() {
    current?.removeAttribute('aria-describedby');
    current = null;
    pop.classList.remove('show');
  }
  const tipOf = (e: Event) => (e.target instanceof Element ? e.target.closest('[data-tip]') : null);
  document.addEventListener('pointerover', (e) => {
    const t = tipOf(e);
    if (t && t !== current) show(t);
    else if (!t && current) hide();
  });
  document.addEventListener('focusin', (e) => {
    const t = tipOf(e);
    if (t) show(t);
  });
  document.addEventListener('focusout', hide);
  addEventListener('scroll', hide, { passive: true });
</script>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    background: var(--ink);
    color: var(--paper);
    padding: 8px 12px;
    z-index: 10;
  }
  .masthead {
    border-bottom: 2px solid var(--ink);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: 20px;
    padding-bottom: 18px;
  }
  .mark {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
  }
  .mark :global(.mark-name) {
    font-size: 1.75rem;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }
  nav a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    padding: 4px 0;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .foot {
    margin-top: clamp(80px, 10vw, 140px);
    border-top: 2px solid var(--ink);
    padding: 32px 0 48px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 36rem) auto;
    justify-content: space-between;
    gap: 24px;
  }
  .foot-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    padding: 3px 10px !important;
  }
  nav a.gh:hover {
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }
  .made {
    grid-column: 1 / -1;
    margin: 8px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    text-align: center;
    color: var(--ink-3);
  }
  .made a {
    color: var(--ink);
  }
  .heart {
    display: inline-block;
    color: var(--s5);
  }
  .made:hover .heart {
    animation: beat 0.9s ease-in-out infinite;
  }
  .rc {
    white-space: nowrap;
  }
  .rc svg {
    vertical-align: -2px;
    margin-right: 5px;
  }
  @keyframes beat {
    0%, 60%, 100% { transform: scale(1); }
    20% { transform: scale(1.3); }
    40% { transform: scale(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .made:hover .heart {
      animation: none;
    }
  }
  @media (max-width: 720px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
