{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fontsovertime",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./web/dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "fontsovertime.com", "custom_domain": true }]
}
